{
  "name": "ooo-bidpliot",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "description": "招投标工作台：AI + 招投标平台。",
  "main": "server/plugin.mjs",
  "exports": {
    ".": "./server/plugin.mjs",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./agent": "./server/agent.mjs",
    "./tools": "./server/native/tools.mjs",
    "./stage-context": "./server/native/stage-context.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node scripts/test-js.mjs",
    "verify": "npm run check && npm run build && npm test && npm run test:business",
    "start": "dsh web --patch cordis.web.patch.yml --no-open --host 127.0.0.1 --port 3080",
    "tools:install": "uv sync --locked --project business/python",
    "test:business": "node scripts/test-business.mjs",
    "directory:prepare": "node scripts/prepare.mjs",
    "directory:check": "node scripts/doctor.mjs",
    "delivery:export": "node scripts/delivery.mjs export",
    "delivery:update": "node scripts/delivery.mjs update",
    "verify:delivery": "node scripts/verify-delivery.mjs",
    "postinstall": "uv sync --locked --project business/python",
    "release:package": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "1.7.6",
    "busboy": "1.6.0",
